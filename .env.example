# Supabase project credentials (team member's risk_scores table)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# If unset, or if the risk_scores table is empty/unreachable, the app
# falls back to generated mock data so the demo still works offline.

# data.go.kr (공공데이터포털) decoded service key — used by scripts/fetch_busan_water_data.py
PUBLIC_DATA_API_KEY=your-decoded-service-key

# 기상청 API Hub (apihub.kma.go.kr) auth key — separate service/key from data.go.kr above
KMA_AUTH_KEY=your-kma-apihub-authkey
