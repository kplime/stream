# Supabase project credentials (team member's risk_scores table)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# If unset, or if the risk_scores table is empty/unreachable, the app
# falls back to generated mock data so the demo still works offline.

# 기상청 공공데이터포털 API 키 (초단기실황 조회서비스)
# data.go.kr → 기상청_단기예보 조회서비스 2.0 → 일반 인증키(디코딩)
VITE_KMA_API_KEY=your-kma-service-key
